; Projeto Godot da Masmorra do Rei Ogro.
; Os dados do jogo ficam em ../data/*.json e são copiados para res://data por tools/godot.sh.

config_version=5

[application]

config/name="Masmorra do Rei Ogro"
config/description="RPG de masmorra 3D com combate por turnos."
run/main_scene="res://scenes/showcase.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
