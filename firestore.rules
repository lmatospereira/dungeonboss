rules_version = '2';
// Regras do Firestore para a Masmorra do Rei Ogro.
// - saves/{uid}: progresso privado de cada jogador (só o dono lê e escreve)
// - players/{uid}: perfil público usado na Invasão e no ranking
// - players/{uid}/defenses: registro de invasões que o dono recolhe ao abrir o jogo
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    match /saves/{uid} {
      allow read, delete: if isMe(uid);
      allow write: if isMe(uid)
        && request.resource.data.keys().hasOnly(['save', 'updatedAt'])
        && request.resource.data.save is string
        && request.resource.data.save.size() < 20000;
    }

    match /players/{uid} {
      function validPlayer() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'rating', 'wins', 'losses', 'power', 'defense', 'updatedAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
          && d.rating is int && d.rating >= 0 && d.rating <= 100000
          && d.wins is int && d.losses is int
          && d.power is int && d.power >= 0
          && d.defense is list && d.defense.size() <= 4;
      }
      allow read: if signedIn();
      allow create: if isMe(uid) && validPlayer() && request.resource.data.rating <= 1100;
      // A pontuação só pode subir um pouco por gravação (dificulta trapaça simples).
      allow update: if isMe(uid) && validPlayer()
        && request.resource.data.rating - resource.data.rating <= 100;
      allow delete: if isMe(uid);

      match /defenses/{id} {
        allow read, delete: if isMe(uid);
        allow create: if signedIn() && request.auth.uid != uid
          && request.resource.data.keys().hasOnly(['attacker', 'attackerUid', 'attackerWon', 'delta', 'at'])
          && request.resource.data.attackerUid == request.auth.uid
          && request.resource.data.attacker is string && request.resource.data.attacker.size() <= 20
          && request.resource.data.attackerWon is bool
          && request.resource.data.delta is int
          && request.resource.data.delta >= -32 && request.resource.data.delta <= 32;
      }
    }
  }
}
